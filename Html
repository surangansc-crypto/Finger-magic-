<!DOCTYPE html>
<html lang="si">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ඇඟිලි ආධාරයෙන් ගුණ කිරීම - Nethmi Bhagya</title>
    <style>
        :root {
            --primary: #4f46e5;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
        body { background-color: var(--bg); color: var(--text-main); padding-bottom: 50px; }
        
        .header {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
            color: white; padding: 25px 15px; text-align: center;
            border-bottom-left-radius: 25px; border-bottom-right-radius: 25px;
            position: relative; box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }
        .timer-box {
            position: absolute; top: 15px; right: 15px;
            background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444;
            padding: 5px 12px; border-radius: 20px; font-weight: bold; font-size: 13px; color: #fca5a5;
        }
        .profile-container {
            width: 110px; height: 110px; margin: 0 auto 10px;
            border-radius: 50%; border: 4px solid #38bdf8;
            overflow: hidden; background: #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        .profile-container img { width: 100%; height: 100%; object-fit: cover; }
        .author-title { font-size: 20px; font-weight: 800; color: #38bdf8; }
        .school-title { font-size: 14px; color: #cbd5e1; margin-top: 2px; }
        .app-title { font-size: 20px; font-weight: 800; margin-top: 15px; }

        .container { max-width: 800px; margin: 20px auto; padding: 0 15px; }
        .card {
            background: var(--card-bg); border-radius: 16px; padding: 20px;
            margin-bottom: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); border: 1px solid #e2e8f0;
        }
        .card-title { font-size: 18px; font-weight: 700; color: var(--primary); margin-bottom: 15px; }
        
        .img-display-box {
            text-align: center; background: #fff; padding: 10px;
            border-radius: 12px; border: 2px dashed #cbd5e1; margin-bottom: 15px;
        }
        .img-display-box img { max-width: 100%; height: auto; border-radius: 8px; max-height: 350px; }
        
        .instruction-step {
            background: #f1f5f9; padding: 10px 14px; border-radius: 8px;
            margin-bottom: 8px; font-size: 14px; border-left: 4px solid #06b6d4;
        }

        .action-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .btn-gen {
            background: #0284c7; color: white; border: none; padding: 10px 16px;
            border-radius: 8px; font-weight: bold; cursor: pointer;
        }
        .btn-check {
            background: #16a34a; color: white; border: none; padding: 14px;
            border-radius: 10px; font-size: 17px; font-weight: bold; cursor: pointer;
            width: 100%; margin-top: 15px;
        }
        .questions-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
        .q-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px; }
        .q-row { display: flex; align-items: center; justify-content: space-between; }
        .q-text { font-size: 16px; font-weight: bold; }
        .q-input {
            width: 80px; padding: 6px; font-size: 16px; font-weight: bold;
            text-align: center; border: 2px solid #cbd5e1; border-radius: 6px; outline: none;
        }
        .q-card.correct { background: #f0fdf4; border-color: #86efac; }
        .q-card.wrong { background: #fef2f2; border-color: #fca5a5; }
        .q-expl { font-size: 12px; color: #475569; margin-top: 6px; border-top: 1px dashed #cbd5e1; padding-top: 4px; display: none; }

        /* Lock Screen */
        #lock-screen {
            position: fixed; inset: 0; background: rgba(15, 23, 42, 0.95);
            display: none; align-items: center; justify-content: center; z-index: 9999; padding: 20px;
        }
        .lock-card {
            background: white; padding: 25px; border-radius: 16px; text-align: center;
            max-width: 350px; width: 100%;
        }
        .lock-input {
            width: 100%; padding: 10px; font-size: 16px; text-align: center;
            border: 2px solid #cbd5e1; border-radius: 8px; margin: 15px 0; outline: none;
        }
        .lock-btn {
            background: var(--primary); color: white; width: 100%; padding: 12px;
            border: none; border-radius: 8px; font-weight: bold; cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="timer-box">
            <span>⏱️ ඉතිරි කාලය:</span>
            <span id="timer-display">20:00</span>
        </div>
        <div class="profile-container">
            <!-- nethmi.jpg ලෙස ෆයිල් එක තබන්න -->
            <img src="nethmi.jpg" alt="Nethmi Bhagya" onerror="this.src='https://via.placeholder.com/150?text=Photo';">
        </div>
        <div class="author-title">Created by Nethmi Bhagya</div>
        <div class="school-title">ර/කුරුවිට මධ්‍ය මහා විද්‍යාලය (ජාතික පාසල)</div>
        <div class="app-title">ඇඟිලි ආධාරයෙන් 6 සිට 10 දක්වා ගුණ කිරීම</div>
    </div>

    <div class="container">
        <div class="card">
            <div class="card-title">📖 ඇඟිලි වලින් ගුණ කරන ක්‍රමය</div>
            <div class="img-display-box">
                <!-- hands.jpg ලෙස ෆයිල් එක තබන්න -->
                <img src="hands.jpg" alt="Ascribe Values" onerror="this.src='https://via.placeholder.com/400x200?text=Hands+Diagram';">
            </div>
            <div class="instruction-step"><strong>පියවර 1:</strong> සුළැඟිල්ල = 6, වෙදැඟිල්ල = 7, මැදැඟිල්ල = 8, දබරැඟිල්ල = 9, මහපට ඇඟිල්ල = 10 ලෙස ගණන් ගන්න.</div>
            <div class="instruction-step"><strong>පියවර 2:</strong> ගුණ කිරීමට අවශ්‍ය ඇඟිලි දෙක එකට ස්පර්ශ කරන්න (උදා: 7 × 8 සඳහා වම් අතේ 7 සහ දකුණු අතේ 8).</div>
            <div class="instruction-step"><strong>පියවර 3:</strong> ස්පර්ශ කළ ඇඟිලි සහ ඊට පහළ සියලු ඇඟිලි ගණන් කර 10න් ගුණ කරන්න (ඇඟිලි 5 = 50).</div>
            <div class="instruction-step"><strong>පියවර 4:</strong> ඉහළින් ඉතිරි වූ ඇඟිලි ගණන එකිනෙක ගුණ කරන්න (3 × 2 = 6). දැන් දෙකම එකතු කරන්න (50 + 6 = 56).</div>
        </div>

        <div class="card">
            <div class="action-bar">
                <div class="card-title" style="margin-bottom:0;">📝 අභ්‍යාස ගණන් 20</div>
                <button class="btn-gen" onclick="generateQuestions()">🎲 අලුත් ගණන්</button>
            </div>
            <div class="questions-grid" id="q-container"></div>
            <button class="btn-check" onclick="checkAnswers()">✅ පිළිතුරු පරීක්ෂා කරන්න</button>
            <div id="score-result" style="margin-top:15px; font-size:18px; font-weight:bold; text-align:center;"></div>
        </div>
    </div>

    <div id="lock-screen">
        <div class="lock-card">
            <div style="font-size:36px; margin-bottom:8px;">🔒</div>
            <h3>කාලය අවසන් විය</h3>
            <p style="font-size:13px; color:#64748b; margin-top:4px;">නැවත විවෘත කිරීමට මුරපදය ඇතුළත් කරන්න.</p>
            <input type="password" id="pass-input" class="lock-input" placeholder="Password ඇතුළත් කරන්න">
            <button class="lock-btn" onclick="unlockApp()">විවෘත කරන්න</button>
            <p id="lock-err" style="color:red; font-size:12px; margin-top:8px; display:none;">මුරපදය වැරදියි!</p>
        </div>
    </div>

    <script>
        let currentQuestions = [];
        function generateQuestions() {
            const container = document.getElementById('q-container');
            container.innerHTML = '';
            currentQuestions = [];
            document.getElementById('score-result').innerHTML = '';

            for (let i = 1; i <= 20; i++) {
                const a = Math.floor(Math.random() * 5) + 6;
                const b = Math.floor(Math.random() * 5) + 6;
                currentQuestions.push({ num1: a, num2: b, ans: a * b });

                const qCard = document.createElement('div');
                qCard.className = 'q-card';
                qCard.id = `qc-${i}`;
                qCard.innerHTML = `
                    <div class="q-row">
                        <span class="q-text">${i}) &nbsp; ${a} × ${b} =</span>
                        <input type="number" class="q-input" id="ans-${i}">
                        <span id="badge-${i}" style="font-weight:bold; font-size:18px;"></span>
                    </div>
                    <div class="q-expl" id="expl-${i}">
                        ක්‍රමය: පහළ (${(a-5)+(b-5)}) × 10 = ${((a-5)+(b-5))*10} | ඉහළ (${10-a} × ${10-b}) = ${(10-a)*(10-b)} 👉 එකතුව = ${a*b}
                    </div>
                `;
                container.appendChild(qCard);
            }
        }

        function checkAnswers() {
            let score = 0;
            currentQuestions.forEach((q, idx) => {
                const i = idx + 1;
                const input = document.getElementById(`ans-${i}`);
                const card = document.getElementById(`qc-${i}`);
                const badge = document.getElementById(`badge-${i}`);
                const expl = document.getElementById(`expl-${i}`);
                const val = parseInt(input.value.trim());

                expl.style.display = 'block';
                if (val === q.ans) {
                    score++;
                    card.className = 'q-card correct';
                    badge.innerHTML = '✅';
                    badge.style.color = '#16a34a';
                } else {
                    card.className = 'q-card wrong';
                    badge.innerHTML = `❌ (${q.ans})`;
                    badge.style.color = '#dc2626';
                }
            });

            const res = document.getElementById('score-result');
            res.innerHTML = `ඔබේ ලකුණු: 20 න් ${score} කි! ` + (score >= 15 ? '🌟 විශිෂ්ටයි!' : '💪 තව උත්සාහ කරන්න!');
            res.style.color = score >= 15 ? '#16a34a' : '#d97706';
        }

        let timeLeft = 20 * 60;
        const timerDisp = document.getElementById('timer-display');
        const lockScreen = document.getElementById('lock-screen');

        const timerInterval = setInterval(() => {
            timeLeft--;
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            timerDisp.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                lockScreen.style.display = 'flex';
            }
        }, 1000);

        function unlockApp() {
            const pass = document.getElementById('pass-input').value.trim();
            if (pass === 'Nethmi2026') {
                lockScreen.style.display = 'none';
                document.getElementById('lock-err').style.display = 'none';
                timeLeft = 20 * 60;
            } else {
                document.getElementById('lock-err').style.display = 'block';
            }
        }

        generateQuestions();
    </script>
</body>
</html>
